# Release recipe. prepare-source.py also produces the archive for local testing.
# Publish the matching GitHub release before submitting this recipe to the AUR.
pkgname=chainlight
pkgver=0.3.0
pkgrel=1
pkgdesc='Portable terminal dashboard for Bitcoin Core with optional Omarchy integration'
url='https://github.com/gnulnx/Chainlight'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('bash' 'glibc' 'gcc-libs')
optdepends=('bitcoin-daemon: local Bitcoin node' 'omarchy: themed desktop launcher')
makedepends=('rust')
options=('!debug')
source=("$pkgname-$pkgver.tar.gz::$url/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('2d79625ad8e49707fec4c143ce53bc412cbe0efea5ad9cea656aa3c4c6a9afea')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  cargo build --locked --release
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  install -Dm755 target/release/chainlight "$pkgdir/usr/bin/chainlight"
  install -Dm755 integrations/omarchy/chainlight-omarchy "$pkgdir/usr/bin/chainlight-omarchy"
  install -Dm644 integrations/desktop/chainlight.desktop "$pkgdir/usr/share/applications/chainlight.desktop"
  install -Dm644 assets/chainlight.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/chainlight.svg"
  for size in 16 32 48 64 128 256; do
    install -Dm644 "assets/chainlight-$size.png" "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/chainlight.png"
  done
  install -Dm644 docs/INSTALL.md "$pkgdir/usr/share/doc/$pkgname/INSTALL.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 docs/NODE.md "$pkgdir/usr/share/doc/$pkgname/NODE.md"
}
